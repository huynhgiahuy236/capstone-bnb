# ==========================================
# CẤU HÌNH SERVER
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# CẤU HÌNH DATABASE (MYSQL + PRISMA)
# ==========================================
DATABASE_URL="mysql://root:12345@localhost:3306/capstone_airbnb"

# ==========================================
# CẤU HÌNH JWT (AUTHENTICATION)
# ==========================================
JWT_SECRET="YOUR_JWT_SECRET_KEY"
JWT_EXPIRES_IN="7d"

# ==========================================
# CẤU HÌNH UPLOAD FILE (LOCAL DISK STORAGE)
# ==========================================
UPLOAD_DESTINATION="./public/images"
MAX_FILE_SIZE=10485760 # 10MB

# ==========================================
# CẤU HÌNH CLOUDINARY (CLOUD MEDIA STORAGE)
# ==========================================
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
CLOUDINARY_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ==========================================
# CẤU HÌNH GOOGLE OAUTH 2.0 (SIGNIN GOOGLE)
# ==========================================
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
